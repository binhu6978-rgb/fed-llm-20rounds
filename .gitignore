# Track source, documentation, and the lightweight formal experiment archive.
/*
!/.gitignore
!/README.md
!/requirements-fedlora20-server.txt
!/server_fedlora20_manifest.json
!/alg/
!/configs/
!/docs/
!/scripts/
!/tests/
!/utils/
!/outputs/
/outputs/*
!/outputs/fedavg20_five_client4000_seed42/
!/outputs/fedlora20_server_seed42/
!/outputs/fedlora_baselines_5source_seed42/

# Models, training data, weights, and checkpoints stay on the experiment host.
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.h5
*.hdf5
*.pkl
*.pickle

# Keep scalar metrics and provenance; omit row-level predictions and exposure.
*.jsonl
!metrics.jsonl
*_predictions.csv
*_predictions.json
*_predictions.jsonl
*.log
*.lock
*.tmp
/outputs/**/logs/
/outputs/**/smoke*/
/outputs/**/gpu_probe*/

# Runtime caches, local tooling state, and credentials.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
